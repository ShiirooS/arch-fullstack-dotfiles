{
  "layer": "top",
  "position": "top",
  "height": 34,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "network", "pulseaudio", "battery"],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}"
  },
  "network": {
    "format-wifi": "Wi-Fi {essid}",
    "format-ethernet": "Ethernet",
    "format-disconnected": "Offline"
  },
  "pulseaudio": {
    "format": "Vol {volume}%",
    "format-muted": "Muted"
  },
  "battery": {
    "format": "Bat {capacity}%",
    "format-charging": "Bat {capacity}%"
  }
}
